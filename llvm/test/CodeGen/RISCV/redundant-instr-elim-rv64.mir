# Different values can reach the join, provided the register and spill slot
# agree on every edge. The equality remains true around the loop.
---
name: spill_join_and_loop
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  ; CHECK-LABEL: name: spill_join_and_loop
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ killed $x12, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SD $x10, $x2, 0 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed $x11
  ; CHECK-NEXT:   SD $x10, $x2, 0 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   successors: %bb.3(0x40000000), %bb.4(0x40000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE $x10, $x0, %bb.3
  ; CHECK-NEXT:   PseudoBR %bb.4
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.4:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit killed $x10
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10, $x11, $x12
    BEQ $x12, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    liveins: $x10
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $x11
    $x10 = COPY $x11
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    PseudoBR %bb.3
  bb.3:
    successors: %bb.3, %bb.4
    liveins: $x10
    $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    BNE $x10, $x0, %bb.3
    PseudoBR %bb.4
  bb.4:
    liveins: $x10
    PseudoRET implicit $x10
...

# A predecessor which overwrites the slot prevents elimination at the join.
---
name: spill_join_disagrees
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  ; CHECK-LABEL: name: spill_join_disagrees
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11, $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SD $x10, $x2, 0 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   BEQ $x12, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   SD $x11, $x2, 0 :: (store (s64) into %stack.0)
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10, $x11, $x12
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    BEQ $x12, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.2
    liveins: $x10, $x11
    SD $x11, $x2, 0 :: (store (s64) into %stack.0)
    PseudoBR %bb.2
  bb.2:
    liveins: $x10
    $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    PseudoRET implicit $x10
...

