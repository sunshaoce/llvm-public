# An address alone is not a compiler-owned spill-slot identity.
---
name: unknown_memory
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: unknown_memory
    ; CHECK: $x10 = LD $x2, 0
    ; CHECK-NEXT: $x10 = LD $x2, 0
    ; CHECK-NEXT: $x10 = LD $x2, 0 :: (load (s64))
    ; CHECK-NEXT: $x10 = LD $x2, 0 :: (load (s64))
    ; CHECK-NEXT: PseudoRET implicit $x10
    $x10 = LD $x2, 0
    $x10 = LD $x2, 0
    $x10 = LD $x2, 0 :: (load (s64))
    $x10 = LD $x2, 0 :: (load (s64))
    PseudoRET implicit $x10
...

# A sign-extending word load is not a full RV64 reload.
---
name: narrow_reload
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: narrow_reload
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: $x10 = LW $x2, 0 :: (load (s32) from %stack.0)
    ; CHECK-NEXT: $x10 = LW $x2, 0 :: (load (s32) from %stack.0)
    ; CHECK-NEXT: $x11 = LD $x2, 0 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    $x10 = LW $x2, 0 :: (load (s32) from %stack.0)
    $x10 = LW $x2, 0 :: (load (s32) from %stack.0)
    $x11 = LD $x2, 0 :: (load (s64) from %stack.0)
    PseudoRET implicit $x10, implicit $x11
...

# Partial stores and stores to other frame indices invalidate spill facts.
---
name: aliasing_stores
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 8, alignment: 8 }
  - { id: 1, type: spill-slot, size: 8, alignment: 8 }
body: |
  bb.0:
    liveins: $x10, $x11
    ; CHECK-LABEL: name: aliasing_stores
    ; CHECK: liveins: $x10, $x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: SW $x11, $x2, 0 :: (store (s32) into %stack.0)
    ; CHECK-NEXT: $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    ; CHECK-NEXT: SD $x11, $x2, 0 :: (store (s64) into %stack.1)
    ; CHECK-NEXT: $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit $x10
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    SW $x11, $x2, 0 :: (store (s32) into %stack.0)
    $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    SD $x10, $x2, 0 :: (store (s64) into %stack.0)
    SD $x11, $x2, 0 :: (store (s64) into %stack.1)
    $x10 = LD $x2, 0 :: (load (s64) from %stack.0)
    PseudoRET implicit $x10
...

