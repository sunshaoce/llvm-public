# RUN: llc -mtriple=riscv64 -mattr=+d -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s

# ADDIW truncates before sign-extending. ADDI and logical shifts do not.
---
name: word_constants
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: word_constants
    ; CHECK: $x10 = LUI 524288
    ; CHECK-NEXT: dead $x11 = ADDIW $x10, -1
    ; CHECK-NEXT: dead $x11 = ADDI $x10, -1
    ; CHECK-NEXT: $x11 = ADDIW $x10, -1
    ; CHECK-NEXT: dead $x12 = ADDI $x0, -1
    ; CHECK-NEXT: dead $x12 = SRLIW $x10, 31
    ; CHECK-NEXT: $x12 = SRLI killed $x10, 31
    ; CHECK-NEXT: $x13 = ADDI $x0, 1
    ; CHECK-NEXT: $x14 = SLLI killed $x13, 32
    ; CHECK-NEXT: $x14 = ADDIW killed $x14, 0
    ; CHECK-NEXT: PseudoRET implicit killed $x11, implicit killed $x12, implicit killed $x14
    $x10 = LUI 524288
    $x11 = ADDIW $x10, -1
    $x11 = ADDI $x10, -1
    $x11 = ADDIW $x10, -1
    $x12 = ADDI $x0, -1
    $x12 = SRAIW $x10, 31
    $x12 = SRAI $x10, 63
    $x12 = SRLIW $x10, 31
    $x12 = SRLI $x10, 31
    $x13 = ADDI $x0, 1
    $x14 = SLLI $x13, 32
    $x14 = ADDIW $x14, 0
    $x14 = ADDI $x0, 0
    PseudoRET implicit $x11, implicit $x12, implicit $x14
...

