# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -mattr=+f -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv32 -mattr=+f -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s

# LW/SW are full-width only on RV32.
---
name: integer_spill
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $x10, $x12
    ; CHECK-LABEL: name: integer_spill
    ; CHECK: liveins: $x10, $x12
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: SW $x10, $x2, 0 :: (store (s32) into %stack.0)
    ; CHECK-NEXT: dead $x11 = LW $x2, 0 :: (load (s32) from %stack.0)
    ; CHECK-NEXT: SH killed $x12, $x2, 0 :: (store (s16) into %stack.0)
    ; CHECK-NEXT: $x11 = LW $x2, 0 :: (load (s32) from %stack.0)
    ; CHECK-NEXT: PseudoRET implicit killed $x10, implicit killed $x11
    SW $x10, $x2, 0 :: (store (s32) into %stack.0)
    $x10 = LW $x2, 0 :: (load (s32) from %stack.0)
    $x11 = LW $x2, 0 :: (load (s32) from %stack.0)
    $x11 = LW $x2, 0 :: (load (s32) from %stack.0)
    SH $x12, $x2, 0 :: (store (s16) into %stack.0)
    $x11 = LW $x2, 0 :: (load (s32) from %stack.0)
    PseudoRET implicit $x10, implicit $x11
...

---
name: single_precision_fp
tracksRegLiveness: true
stack:
  - { id: 0, type: spill-slot, size: 4, alignment: 4 }
body: |
  bb.0:
    liveins: $f0_f
    ; CHECK-LABEL: name: single_precision_fp
    ; CHECK: liveins: $f0_f
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $f1_f = FSGNJ_S $f0_f, $f0_f
    ; CHECK-NEXT: $x10 = FMV_X_W $f1_f
    ; CHECK-NEXT: FSW $f0_f, $x2, 0 :: (store (s32) into %stack.0)
    ; CHECK-NEXT: PseudoRET implicit killed $f0_f, implicit killed $f1_f, implicit killed $x10
    $f1_f = FSGNJ_S $f0_f, $f0_f
    $f1_f = FSGNJ_S $f0_f, $f0_f
    $x10 = FMV_X_W $f1_f
    $x10 = FMV_X_W $f0_f
    $f1_f = FMV_W_X $x10
    FSW $f0_f, $x2, 0 :: (store (s32) into %stack.0)
    $f0_f = FLW $x2, 0 :: (load (s32) from %stack.0)
    PseudoRET implicit $f0_f, implicit $f1_f, implicit $x10
...

# A pair COPY is tracked component by component; a scalar write breaks it.
---
name: register_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10_x11, $x14
    ; CHECK-LABEL: name: register_pair
    ; CHECK: liveins: $x14, $x10_x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $x12_x13 = COPY $x10_x11
    ; CHECK-NEXT: dead $x13 = ADDI killed $x14, 1
    ; CHECK-NEXT: $x12_x13 = COPY killed $x10_x11
    ; CHECK-NEXT: PseudoRET implicit killed $x12_x13
    $x12_x13 = COPY $x10_x11
    $x12_x13 = COPY $x10_x11
    $x13 = ADDI $x14, 1
    $x12_x13 = COPY $x10_x11
    PseudoRET implicit $x12_x13
...

# Constant evaluation wraps at XLEN, including a negative LUI.
---
name: wrapping_constants
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: wrapping_constants
    ; CHECK: $x10 = LUI 524288
    ; CHECK-NEXT: dead $x11 = ADDI killed $x10, -1
    ; CHECK-NEXT: $x11 = LUI 524288
    ; CHECK-NEXT: $x11 = ADDI killed $x11, -1
    ; CHECK-NEXT: $x12 = ADDI $x0, -1
    ; CHECK-NEXT: PseudoRET implicit killed $x11, implicit killed $x12
    $x10 = LUI 524288
    $x11 = ADDI $x10, -1
    $x11 = LUI 524288
    $x11 = ADDI $x11, -1
    $x12 = ADDI $x0, -1
    $x12 = SRAI $x10, 31
    PseudoRET implicit $x11, implicit $x12
...
