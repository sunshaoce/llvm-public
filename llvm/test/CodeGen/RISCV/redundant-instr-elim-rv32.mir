# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -mattr=+f -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv32 -mattr=+f -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s

# A pair COPY is tracked component by component; a scalar write breaks it.
---
name: register_pair
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10_x11, $x14
    ; CHECK-LABEL: name: register_pair
    ; CHECK: liveins: $x14, $x10_x11
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $x12_x13 = COPY $x10_x11
    ; CHECK-NEXT: dead $x13 = ADDI killed $x14, 1
    ; CHECK-NEXT: $x12_x13 = COPY killed $x10_x11
    ; CHECK-NEXT: PseudoRET implicit killed $x12_x13
    $x12_x13 = COPY $x10_x11
    $x12_x13 = COPY $x10_x11
    $x13 = ADDI $x14, 1
    $x12_x13 = COPY $x10_x11
    PseudoRET implicit $x12_x13
...

# Constant evaluation wraps at XLEN, including a negative LUI.
---
name: wrapping_constants
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: wrapping_constants
    ; CHECK: $x10 = LUI 524288
    ; CHECK-NEXT: dead $x11 = ADDI killed $x10, -1
    ; CHECK-NEXT: $x11 = LUI 524288
    ; CHECK-NEXT: $x11 = ADDI killed $x11, -1
    ; CHECK-NEXT: $x12 = ADDI $x0, -1
    ; CHECK-NEXT: PseudoRET implicit killed $x11, implicit killed $x12
    $x10 = LUI 524288
    $x11 = ADDI $x10, -1
    $x11 = LUI 524288
    $x11 = ADDI $x11, -1
    $x12 = ADDI $x0, -1
    $x12 = SRAI $x10, 31
    PseudoRET implicit $x11, implicit $x12
...
