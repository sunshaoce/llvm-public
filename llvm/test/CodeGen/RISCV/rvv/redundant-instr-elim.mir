# NOTE: Assertions have been autogenerated by utils/update_mir_test_checks.py UTC_ARGS: --version 6
# RUN: llc -mtriple=riscv32 -mattr=+v -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv64 -mattr=+v -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv32 -mattr=+v -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv64 -mattr=+v -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s

--- |
  define void @whole_register_groups() { ret void }
  define void @partial_group_clobber() { ret void }
  define void @unknown_vstart() { ret void }
  define void @csr_reset_and_read() { ret void }
  define void @vsetvl_resets_vstart() { ret void }
  define void @vsetvli_mc_resets_vstart() { ret void }
  define void @vector_copy_pseudo() { ret void }
  define void @naked_entry() naked { ret void }
  define void @vstart_join() { ret void }
...

# Each group member is tracked separately, independent of VL and LMUL.
---
name: whole_register_groups
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8m8, $v16m8
    ; CHECK-LABEL: name: whole_register_groups
    ; CHECK: liveins: $v8m8, $v16m8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $v0 = VMV1R_V $v8, implicit $vtype
    ; CHECK-NEXT: dead $v0m2 = VMV2R_V $v8m2, implicit $vtype
    ; CHECK-NEXT: dead $v0m4 = VMV4R_V $v8m4, implicit $vtype
    ; CHECK-NEXT: dead $v0m8 = VMV8R_V killed $v8m8, implicit $vtype
    ; CHECK-NEXT: $v8m8 = VMV8R_V killed $v16m8, implicit $vtype
    ; CHECK-NEXT: $v0m8 = VMV8R_V killed $v8m8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0m8
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0m2 = VMV2R_V $v8m2, implicit $vtype
    $v0m2 = VMV2R_V $v8m2, implicit $vtype
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    $v0m8 = VMV8R_V $v8m8, implicit $vtype
    $v0m8 = VMV8R_V $v8m8, implicit $vtype
    $v8m8 = VMV8R_V $v16m8, implicit $vtype
    $v0m8 = VMV8R_V $v8m8, implicit $vtype
    PseudoRET implicit $v0m8
...

# A single-register definition invalidates the enclosing group equality.
---
name: partial_group_clobber
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8m4, $v16
    ; CHECK-LABEL: name: partial_group_clobber
    ; CHECK: liveins: $v16, $v8m4
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $v0m4 = VMV4R_V $v8m4, implicit $vtype
    ; CHECK-NEXT: dead $v1 = VMV1R_V $v16, implicit $vtype
    ; CHECK-NEXT: dead $v0m4 = VMV4R_V $v8m4, implicit $vtype
    ; CHECK-NEXT: $v9 = VMV1R_V killed $v16, implicit $vtype
    ; CHECK-NEXT: $v0m4 = VMV4R_V killed $v8m4, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0m4
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    $v1 = VMV1R_V $v16, implicit $vtype
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    $v9 = VMV1R_V $v16, implicit $vtype
    $v0m4 = VMV4R_V $v8m4, implicit $vtype
    PseudoRET implicit $v0m4
...

# With nonzero/unknown vstart the first move may preserve prestart elements.
# It clears vstart, so only the third move is provably redundant.
---
name: unknown_vstart
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v0, $v8, $x10
    ; CHECK-LABEL: name: unknown_vstart
    ; CHECK: liveins: $v0, $v8, $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x0 = CSRRW 8, killed $x10
    ; CHECK-NEXT: dead $v0 = VMV1R_V $v8, implicit killed $v0, implicit $vtype
    ; CHECK-NEXT: $v0 = VMV1R_V killed $v8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0
    $x0 = CSRRW 8, $x10
    $v0 = VMV1R_V $v8, implicit $v0, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0
...

# A read-only CSR access preserves vstart; explicit zero writes establish it.
---
name: csr_reset_and_read
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8
    ; CHECK-LABEL: name: csr_reset_and_read
    ; CHECK: liveins: $v8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x0 = CSRRWI 8, 0
    ; CHECK-NEXT: dead $v0 = VMV1R_V $v8, implicit $vtype
    ; CHECK-NEXT: $x10 = CSRRS 8, $x0
    ; CHECK-NEXT: $x0 = CSRRSI 8, 1
    ; CHECK-NEXT: dead $v0 = VMV1R_V $v8, implicit $vtype
    ; CHECK-NEXT: $x0 = CSRRWI 8, 0
    ; CHECK-NEXT: $v0 = VMV1R_V killed $v8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0, implicit killed $x10
    $x0 = CSRRWI 8, 0
    $v0 = VMV1R_V $v8, implicit $vtype
    $x10 = CSRRS 8, $x0
    $v0 = VMV1R_V $v8, implicit $vtype
    $x0 = CSRRSI 8, 1
    $v0 = VMV1R_V $v8, implicit $vtype
    $x0 = CSRRWI 8, 0
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0, implicit $x10
...

# VSETVLI resets vstart even when both operands are x0.
---
name: vsetvl_resets_vstart
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8
    ; CHECK-LABEL: name: vsetvl_resets_vstart
    ; CHECK: liveins: $v8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect
    ; CHECK-NEXT: $x0 = PseudoVSETVLIX0X0 $x0, 0 /* e8, m1, tu, mu */, implicit-def $vl, implicit-def $vtype
    ; CHECK-NEXT: $v0 = VMV1R_V killed $v8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0
    INLINEASM &"", sideeffect attdialect
    $x0 = PseudoVSETVLIX0X0 $x0, 0, implicit-def $vl, implicit-def $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0
...

# The MC form also resets vstart, although it is marked as having side effects.
---
name: vsetvli_mc_resets_vstart
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8
    ; CHECK-LABEL: name: vsetvli_mc_resets_vstart
    ; CHECK: liveins: $v8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect
    ; CHECK-NEXT: $x0 = VSETVLI $x0, 0 /* e8, m1, tu, mu */, implicit-def $vl, implicit-def $vtype
    ; CHECK-NEXT: $v0 = VMV1R_V killed $v8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0
    INLINEASM &"", sideeffect attdialect
    $x0 = VSETVLI $x0, 0, implicit-def $vl, implicit-def $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0
...

---
name: vector_copy_pseudo
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v8m2
    ; CHECK-LABEL: name: vector_copy_pseudo
    ; CHECK: liveins: $v8m2
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $v0m2 = COPY killed $v8m2
    ; CHECK-NEXT: PseudoRET implicit killed $v0m2
    $v0m2 = COPY $v8m2
    $v0m2 = COPY $v8m2
    PseudoRET implicit $v0m2
...

# Naked functions have no ABI guarantee that vstart is initially zero.
---
name: naked_entry
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $v0, $v8
    ; CHECK-LABEL: name: naked_entry
    ; CHECK: liveins: $v0, $v8
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: dead $v0 = VMV1R_V $v8, implicit killed $v0, implicit $vtype
    ; CHECK-NEXT: $v0 = VMV1R_V killed $v8, implicit $vtype
    ; CHECK-NEXT: PseudoRET implicit killed $v0
    $v0 = VMV1R_V $v8, implicit $v0, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0
...

# Both value equality and vstart=0 must hold on every predecessor.
---
name: vstart_join
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: vstart_join
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $v8, $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $v0 = VMV1R_V $v8, implicit $vtype
  ; CHECK-NEXT:   BNE killed $x10, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $v0, $v8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x0 = CSRRSI 8, 1
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $v0, $v8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $v0, $v8
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead $v0 = VMV1R_V $v8, implicit killed $v0, implicit $vtype
  ; CHECK-NEXT:   $v0 = VMV1R_V killed $v8, implicit $vtype
  ; CHECK-NEXT:   PseudoRET implicit killed $v0
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $v8, $x10
    $v0 = VMV1R_V $v8, implicit $vtype
    BNE $x10, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    liveins: $v0, $v8
    $x0 = CSRRSI 8, 1
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $v0, $v8
    PseudoBR %bb.3
  bb.3:
    liveins: $v0, $v8
    $v0 = VMV1R_V $v8, implicit $v0, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    $v0 = VMV1R_V $v8, implicit $vtype
    PseudoRET implicit $v0
...
