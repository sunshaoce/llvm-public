# Callee-saved facts survive a call mask; caller-saved facts do not.
---
name: call_regmask
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: call_regmask
    ; CHECK: $x8 = ADDI $x0, 7
    ; CHECK-NEXT: dead $x10 = ADDI $x0, 7
    ; CHECK-NEXT: PseudoCALL target-flags(riscv-call) &callee, csr_ilp32_lp64, implicit-def dead $x1
    ; CHECK-NEXT: $x10 = ADDI $x0, 7
    ; CHECK-NEXT: PseudoRET implicit killed $x8, implicit killed $x10
    $x8 = ADDI $x0, 7
    $x10 = ADDI $x0, 7
    PseudoCALL target-flags(riscv-call) &callee, csr_ilp32_lp64, implicit-def $x1
    $x8 = ADDI $x0, 7
    $x10 = ADDI $x0, 7
    PseudoRET implicit $x8, implicit $x10
...

---
name: inline_asm_clobbers
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: inline_asm_clobbers
    ; CHECK: dead $x10 = ADDI $x0, 7
    ; CHECK-NEXT: $x11 = ADDI $x0, 7
    ; CHECK-NEXT: INLINEASM &"", sideeffect attdialect, clobber, implicit-def dead early-clobber $x10
    ; CHECK-NEXT: $x10 = ADDI $x0, 7
    ; CHECK-NEXT: PseudoRET implicit killed $x10, implicit killed $x11
    $x10 = ADDI $x0, 7
    $x11 = ADDI $x0, 7
    INLINEASM &"", sideeffect attdialect, 12 /* clobber */, implicit-def early-clobber $x10
    $x10 = ADDI $x0, 7
    $x11 = ADDI $x0, 7
    PseudoRET implicit $x10, implicit $x11
...

# Outlined helpers may have a register interface absent from the MIR operands.
---
name: outlined
isOutlined: true
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: outlined
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: PseudoRET implicit $x11
    $x11 = COPY $x10
    $x11 = COPY $x10
    PseudoRET implicit $x11
...

# External entry into an address-taken block invalidates predecessor facts.
---
name: address_taken_block
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: address_taken_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x11 = COPY $x10
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1 (machine-block-address-taken):
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x11 = COPY $x10
  ; CHECK-NEXT:   PseudoRET implicit $x11
  bb.0:
    successors: %bb.1
    liveins: $x10
    $x11 = COPY $x10
    PseudoBR %bb.1
  bb.1 (machine-block-address-taken):
    liveins: $x10
    $x11 = COPY $x10
    PseudoRET implicit $x11
...

# Additional definitions prevent treating an instruction as a pure copy.
---
name: implicit_definition
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: implicit_definition
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: $x11 = COPY $x10, implicit-def $x12
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: PseudoRET implicit $x11, implicit $x12
    $x11 = COPY $x10
    $x11 = COPY $x10, implicit-def $x12
    $x11 = COPY $x10
    PseudoRET implicit $x11, implicit $x12
...

---
