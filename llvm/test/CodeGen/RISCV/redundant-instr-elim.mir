...

# Unreachable blocks are left alone; they cannot seed facts for reachable code.
---
name: unreachable_block
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: unreachable_block
  ; CHECK: bb.0:
  ; CHECK-NEXT:   PseudoRET
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x11 = COPY $x10
  ; CHECK-NEXT:   $x11 = COPY $x10
  ; CHECK-NEXT:   PseudoRET implicit $x11
  bb.0:
    PseudoRET
  bb.1:
    liveins: $x10
    $x11 = COPY $x10
    $x11 = COPY $x10
    PseudoRET implicit $x11
...

# Instructions within a bundle must not be removed independently.
---
name: bundled_copies
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: bundled_copies
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: BUNDLE implicit-def $x11, implicit $x10 {
    ; CHECK-NEXT:   $x11 = COPY $x10
    ; CHECK-NEXT:   $x11 = COPY $x10
    ; CHECK-NEXT: }
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: PseudoRET implicit $x11
    BUNDLE implicit-def $x11, implicit $x10 {
      $x11 = COPY $x10
      $x11 = COPY $x10
    }
    $x11 = COPY $x10
    PseudoRET implicit $x11
...

# An impossible equality edge must not invent a value or poison the join.
---
name: infeasible_constant_edge
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: infeasible_constant_edge
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = ADDI $x0, 5
  ; CHECK-NEXT:   $x11 = ADDI $x0, 6
  ; CHECK-NEXT:   BEQ $x10, killed $x11, %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.2(0x80000000)
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   dead $x10 = ADDI $x0, 6
  ; CHECK-NEXT:   $x10 = ADDI $x0, 6
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit killed $x10
  bb.0:
    successors: %bb.1, %bb.2
    $x10 = ADDI $x0, 5
    $x11 = ADDI $x0, 6
    BEQ $x10, $x11, %bb.1
    PseudoBR %bb.2
  bb.1:
    successors: %bb.2
    liveins: $x10
    $x10 = ADDI $x0, 6
    $x10 = ADDI $x0, 6
    PseudoBR %bb.2
  bb.2:
    $x10 = ADDI $x0, 5
    PseudoRET implicit $x10
...
