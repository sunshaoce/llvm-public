# RUN: llc -mtriple=riscv32 -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv64 -run-pass=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv32 -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=riscv64 -passes=riscv-redundant-instr-elim -verify-machineinstrs %s -o - | FileCheck %s

# Copies recognized by RISCVInstrInfo.
---
name: integer_copies
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: integer_copies
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x11 = ADDI $x10, 0
    ; CHECK-NEXT: PseudoRET implicit killed $x10, implicit killed $x11
    $x11 = ADDI $x10, 0
    $x11 = XOR $x0, $x10
    $x11 = OR $x10, $x0
    $x11 = ADD $x0, $x10
    $x11 = SUB $x10, $x0
    $x11 = COPY $x10
    $x10 = COPY $x11
    PseudoRET implicit $x10, implicit $x11
...

# The same XLEN-bit constant can be constructed by different instructions.
---
name: constant_sequences
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: constant_sequences
    ; CHECK: $x10 = LUI 1
    ; CHECK-NEXT: $x11 = ADDI killed $x10, 7
    ; CHECK-NEXT: dead $x12 = ADDI $x0, 7
    ; CHECK-NEXT: dead $x12 = ADDI $x0, -1
    ; CHECK-NEXT: $x12 = LUI 1048575
    ; CHECK-NEXT: $x12 = ADDI killed $x12, -1
    ; CHECK-NEXT: PseudoRET implicit killed $x11, implicit killed $x12
    $x10 = LUI 1
    $x11 = ADDI $x10, 7
    $x11 = ORI $x10, 7
    $x11 = XORI $x10, 7
    $x12 = ADDI $x0, 7
    $x11 = ADD $x10, $x12
    $x12 = ADDI $x0, -1
    $x12 = LUI 1048575
    $x12 = ADDI $x12, -1
    PseudoRET implicit $x11, implicit $x12
...

# A clobber invalidates a value; undef operands do not establish equalities.
---
name: clobber_and_undef
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $x10
    ; CHECK-LABEL: name: clobber_and_undef
    ; CHECK: liveins: $x10
    ; CHECK-NEXT: {{  $}}
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: $x10 = ADDI $x10, 1
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: $x11 = COPY undef $x10
    ; CHECK-NEXT: $x11 = COPY $x10
    ; CHECK-NEXT: PseudoRET implicit $x11
    $x11 = COPY $x10
    $x10 = ADDI $x10, 1
    $x11 = COPY $x10
    $x11 = COPY undef $x10
    $x11 = COPY $x10
    PseudoRET implicit $x11
...

# Frame instructions and writes to x0 must remain even when their value agrees.
---
name: frame_and_zero_register
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: frame_and_zero_register
    ; CHECK: $x10 = ADDI $x0, 7
    ; CHECK-NEXT: $x10 = frame-setup ADDI $x0, 7
    ; CHECK-NEXT: $x10 = frame-destroy ADDI $x0, 7
    ; CHECK-NEXT: $x0 = ADDI $x0, 7
    ; CHECK-NEXT: $x11 = COPY $x0
    ; CHECK-NEXT: $x11 = ADDI $x0, 7
    ; CHECK-NEXT: PseudoRET implicit $x10, implicit $x11
    $x10 = ADDI $x0, 7
    $x10 = frame-setup ADDI $x0, 7
    $x10 = frame-destroy ADDI $x0, 7
    $x0 = ADDI $x0, 7
    $x11 = COPY $x0
    $x11 = ADDI $x0, 7
    PseudoRET implicit $x10, implicit $x11
...

# Predecessors compute different values, but agree that x10 == x11.
---
name: join_equalities
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: join_equalities
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x12, $x13, $x14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE killed $x14, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY $x12
  ; CHECK-NEXT:   dead $x11 = COPY killed $x12
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY $x13
  ; CHECK-NEXT:   dead $x11 = COPY killed $x13
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit killed $x10
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x12, $x13, $x14
    BNE $x14, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    liveins: $x12
    $x10 = COPY $x12
    $x11 = COPY $x12
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $x13
    $x10 = COPY $x13
    $x11 = COPY $x13
    PseudoBR %bb.3
  bb.3:
    liveins: $x11
    $x10 = COPY $x11
    PseudoRET implicit $x10
...

# One disagreeing predecessor prevents elimination at a join.
---
name: join_disagrees
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: join_disagrees
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x12, $x13, $x14
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BNE $x14, $x0, %bb.2
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY $x12
  ; CHECK-NEXT:   $x11 = COPY $x12
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   successors: %bb.3(0x80000000)
  ; CHECK-NEXT:   liveins: $x12, $x13
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY $x12
  ; CHECK-NEXT:   $x11 = COPY $x13
  ; CHECK-NEXT:   PseudoBR %bb.3
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.3:
  ; CHECK-NEXT:   liveins: $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY $x11
  ; CHECK-NEXT:   PseudoRET implicit $x10
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x12, $x13, $x14
    BNE $x14, $x0, %bb.2
    PseudoBR %bb.1
  bb.1:
    successors: %bb.3
    liveins: $x12
    $x10 = COPY $x12
    $x11 = COPY $x12
    PseudoBR %bb.3
  bb.2:
    successors: %bb.3
    liveins: $x12, $x13
    $x10 = COPY $x12
    $x11 = COPY $x13
    PseudoBR %bb.3
  bb.3:
    liveins: $x11
    $x10 = COPY $x11
    PseudoRET implicit $x10
...

# The equality edge provides facts even when neither operand is a constant.
---
name: branch_equality
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: branch_equality
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10, $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   BEQ $x10, $x11, %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit killed $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x11
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x10 = COPY killed $x11
  ; CHECK-NEXT:   PseudoRET implicit killed $x10
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $x10, $x11
    BEQ $x10, $x11, %bb.1
    PseudoBR %bb.2
  bb.1:
    liveins: $x11
    $x10 = COPY $x11
    PseudoRET implicit $x10
  bb.2:
    liveins: $x11
    $x10 = COPY $x11
    PseudoRET implicit $x10
...

