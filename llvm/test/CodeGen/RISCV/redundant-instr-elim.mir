# A static definition must not be used as a value identity across iterations.
---
name: loop_variant
tracksRegLiveness: true
body: |
  ; CHECK-LABEL: name: loop_variant
  ; CHECK: bb.0:
  ; CHECK-NEXT:   successors: %bb.1(0x80000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x12 = COPY $x10
  ; CHECK-NEXT:   PseudoBR %bb.1
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.1:
  ; CHECK-NEXT:   successors: %bb.1(0x40000000), %bb.2(0x40000000)
  ; CHECK-NEXT:   liveins: $x10
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   $x11 = COPY $x10
  ; CHECK-NEXT:   $x10 = ADDI $x10, 1
  ; CHECK-NEXT:   $x12 = COPY $x11
  ; CHECK-NEXT:   BNE $x10, $x0, %bb.1
  ; CHECK-NEXT:   PseudoBR %bb.2
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT: bb.2:
  ; CHECK-NEXT:   liveins: $x12
  ; CHECK-NEXT: {{  $}}
  ; CHECK-NEXT:   PseudoRET implicit $x12
  bb.0:
    successors: %bb.1
    liveins: $x10
    $x12 = COPY $x10
    PseudoBR %bb.1
  bb.1:
    successors: %bb.1, %bb.2
    liveins: $x10
    $x11 = COPY $x10
    $x10 = ADDI $x10, 1
    $x12 = COPY $x11
    BNE $x10, $x0, %bb.1
    PseudoBR %bb.2
  bb.2:
    liveins: $x12
    PseudoRET implicit $x12
...

